{
  "name": "gunslingers",
  "private": true,
  "workspaces": [
    "packages/client",
    "packages/interfaces"
  ],
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engine": {
    "node": "23.8.0",
    "npm": "10.5.0"
  },
  "engineStrict": true,
  "dependencies": {
    "vue": "^3.5.21",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@histoire/plugin-vue": "^0.17.17",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-istanbul": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "histoire": "^0.17.17",
    "jscpd": "^4.0.5",
    "jsdom": "^27.0.0",
    "rollup-plugin-visualizer": "^6.0.3",
    "sass": "^1.92.1",
    "typescript": "^5.9.2",
    "vite": "^5.0.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.0"
  },
  "jscpd": {
    "threshold": 10,
    "minTokens": 50,
    "minLines": 5,
    "maxLines": 1000,
    "format": [
      "typescript"
    ],
    "pattern": "src/**/*.(ts|tsx|vue)",
    "ignore": [
      "src/shims-vue.d.ts",
      "src/vite-env.d.ts",
      "src/main.ts",
      "src/router/index.ts",
      "src/store/index.ts",
      "**/*.spec.t(s|sx)"
    ],
    "absolute": true,
    "gitignore": true,
    "reporters": [
      "console",
      "html"
    ]
  }
}
